<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="en"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  lang="en"
  metal:use-macro="context/main_template/macros/master"
  i18n:domain="mbarde.signups"
>
  <body>
    <metal:main fill-slot="main">
      <tal:main-macro metal:define-macro="main">
        <div tal:replace="structure provider:plone.abovecontenttitle" />

        <h1 class="documentFirstHeading" tal:content="context/title" />

        <div tal:replace="structure provider:plone.belowcontenttitle" />

        <p class="documentDescription" tal:content="context/description" />

        <div tal:replace="structure provider:plone.abovecontentbody" />

        <label tal:content="view/w/startTime/label" i18n:translate=""></label>
        <div tal:content="context/getStartTime" />
        <br />

        <label tal:content="view/w/endTime/label" i18n:translate=""></label>
        <div tal:content="context/getEndTime" />
        <br />

        <label tal:content="view/w/name/label" i18n:translate="" />
        <div tal:content="structure view/w/name/render" />
        <br />

        <label tal:content="view/w/maxCapacity/label" i18n:translate="" />
        <div tal:content="structure view/w/maxCapacity/render" />
        <br />

        <label tal:content="view/w/allowWaitingList/label" i18n:translate="" />
        <div tal:content="structure view/w/allowWaitingList/render" />
        <br />

        <div
          class="alert alert-warning"
          id="free-places-while-waiting"
          role="alert"
          tal:define="hint view/getFreePlacesWhileWaitingHint"
          tal:condition="hint"
          tal:content="hint"
        />

        <tal:groups repeat="group view/getPersonGroups">
          <tal:group
            define="persons group/persons;
                    state group/state;
                    alwaysShown python: state in ('signedup', 'waiting')"
            condition="python: persons or (alwaysShown and (state != 'waiting' or context.allowWaitingList))"
          >
            <h3 tal:attributes="id string:persons-${state}">
              <span i18n:translate="" tal:content="group/title" />
              <span
                style="color: white"
                tal:attributes="class string:badge bg-${group/color} ms-1"
                tal:content="python: '%d / %d' % (len(persons), context.maxCapacity) if state == 'signedup' else len(persons)"
              />
            </h3>
            <table
              class="listing table table-bordered"
              tal:condition="persons"
            >
              <tr
                tal:repeat="person persons"
                tal:attributes="class string:table-${group/color}"
              >
                <td>
                  <a tal:attributes="href person/absolute_url">
                    <span tal:replace="person/Title" /> (<span tal:replace="person/id" />)
                  </a>
                </td>
                <td tal:content="person/email" />
              </tr>
            </table>
            <p
              class="discreet"
              tal:condition="not: persons"
              i18n:translate=""
            >No persons</p>
          </tal:group>
        </tal:groups>

        <div tal:replace="structure provider:plone.belowcontentbody" />
      </tal:main-macro>
    </metal:main>
  </body>
</html>