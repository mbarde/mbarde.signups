<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="en"
  metal:use-macro="here/main_template/macros/master"
  i18n:domain="mbarde.signups"
>
  <body>
    <div metal:fill-slot="main" tal:define="timeSlots python: []">
      <metal:block define-macro="macro-timeslots">
        <tal:block tal:repeat="timeSlot timeSlots">
        <tr
          tal:define="rowState timeSlot/getCurrentUserSignUpState;
                      rowFull timeSlot/isFull;
                      rowExpired timeSlot/isRegistrationExpired;
                      selectable python: not rowState and not rowExpired and not rowFull and isSignupAllowed"
          tal:attributes="class python: 'slot-row' if selectable else None;
                          style python: 'cursor: pointer' if selectable else None"
        >
          <td tal:condition="view/showEditLinks">
            <a
              tal:attributes="href string:${timeSlot/absolute_url}/edit"
              i18n:attributes="title"
              title="Edit timeslot"
            >
              <tal:icon
                replace="structure python: icons.tag('plone-edit', tag_alt='Edit timeslot')"
              />
            </a>
            <a
              tal:attributes="href string:${timeSlot/absolute_url}/view"
              i18n:attributes="title"
              title="View timeslot"
            >
              <tal:icon
                replace="structure python: icons.tag('plone-view', tag_alt='View timeslot')"
              />
            </a>
          </td>
          <td tal:condition="showSlotNames">
            <strong><span tal:content="timeSlot/name" /></strong>
          </td>
          <td tal:condition="not: hideDateTime">
            <span tal:content="timeSlot/getTimeRange" />
          </td>
          <td tal:condition="not: hideAvailability">
            <span tal:content="timeSlot/getNumberOfAvailableSlots" />
            <span tal:condition="timeSlot/allowWaitingList">
              + <span i18n:translate="">Waiting List</span></span
            >
          </td>
          <td
            align="center"
            tal:define="state timeSlot/getCurrentUserSignUpState; full timeSlot/isFull"
          >
            <tal:block
              tal:condition="python: state in ['unconfirmed', 'signedup', 'signedoff']"
            >
              <em
                ><strong>
                  &rarr;
                  <span i18n:translate="">Your Slot</span>
                  <span tal:condition="python: state == 'unconfirmed'">
                    (<span i18n:translate="unconfirmed" />)
                  </span>
                  <span
                    tal:condition="python: state == 'signedoff'"
                    i18n:attributes="title"
                    title="Your registration has been canceled"
                  >
                    (
                    <tal:icon
                      replace="structure python: icons.tag('plone-error')"
                    />
                    <span i18n:translate="signedoff" /> )
                  </span>
                  &larr;
                </strong></em
              >
            </tal:block>
            <tal:block tal:condition="python: state == 'waiting'">
              <em
                ><strong
                  >&rarr;
                  <span i18n:translate="on_waiting_list"></span> &larr;</strong
                ></em
              >
            </tal:block>

            <tal:block tal:condition="not:state">
              <tal:block tal:condition="not:timeSlot/isRegistrationExpired">
                <tal:block tal:condition="python: not full and isSignupAllowed">
                  <input
                    tal:condition="isSingleTimeSlot"
                    type="radio"
                    name="slotSelection"
                    tal:attributes="value timeSlot/getIDLabel"
                    checked
                  />
                  <input
                    tal:condition="python: not isSingleTimeSlot and allowSignupForMultipleSlots"
                    type="checkbox"
                    name="slotSelection"
                    tal:attributes="value timeSlot/getIDLabel"
                  />
                  <input
                    tal:condition="python: not isSingleTimeSlot and not allowSignupForMultipleSlots"
                    type="radio"
                    name="slotSelection"
                    tal:attributes="value timeSlot/getIDLabel"
                  />
                </tal:block>
                <span tal:condition="full" i18n:translate="">Full</span>
              </tal:block>
              <span
                tal:condition="timeSlot/isRegistrationExpired"
                i18n:translate=""
                i18n:attributes="title"
                title="Registration expired"
                >(expired)</span
              >
            </tal:block>
          </td>
        </tr>
        </tal:block>
      </metal:block>

      <tal:main-macro
        metal:define-macro="main"
        tal:define="isUserLogged context/isCurrentUserLoggedIn;
                                allowSignupForExternals context/allowSignupForExternals;
                                allowSignupForMultipleSlots context/allowSignupForMultipleSlots;
                                hideAvailability context/hideAvailability;
                                hideDateTime context/hideDateTime;
                                isSignupAllowed python: allowSignupForExternals or isUserLogged;
                                showSlotNames context/showSlotNames;
                                userAlreadySubmitted python: context.countSlotsOfCurrentUser() > 0;
                                prohibitAnotherSignup python: (userAlreadySubmitted and not context.allowSignupForMultipleSlots);
                                isSingleTimeSlot python: context.countSlots() == 1;
                                icons python: context.restrictedTraverse('@@iconresolver');"
      >
        <a
          tal:condition="python: isUserLogged and userAlreadySubmitted"
          tal:attributes="href string:${context/absolute_url}/@@show-reservations"
          class="btn btn-secondary"
        >
          <tal:icon
            replace="structure python: icons.tag('plone-calendar', tag_class='me-1')"
          />
          <span i18n:translate="">View My Reservations</span>
        </a>

        <h2 tal:content="context/Title" />

        <div tal:condition="context/text" id="description">
          <tal:block tal:replace="structure view/w/text/render"> </tal:block>
        </div>

        <div
          class="portalMessage statusmessage-info alert alert-info"
          role="alert"
          tal:condition="prohibitAnotherSignup"
        >
          <tal:icon
            replace="structure python: icons.tag('plone-statusmessage-info', tag_alt='Info:', tag_class='statusmessage-icon mb-1 me-2')"
          />
          <strong i18n:translate="">Info:</strong>
          <span class="content" i18n:translate=""
            >You are already signed up for a slot in this signup sheet and
            multiple signups are not allowed.</span
          >
        </div>

        <br />

        <tal:block tal:condition="context/contactInfo">
          <span i18n:translate=""
            >If you have any questions please contact:</span
          >
          <a
            tal:attributes="href python: 'mailto:' + context.contactInfo"
            tal:content="python: context.getContactInfoAsSentence()"
            >mailto</a
          >
          <br /><br />
        </tal:block>

        <form
          method="post"
          id="formSubmitTimeslots"
          tal:attributes="action string:${context/absolute_url}/@@submit-user-selection;"
        >
          <tal:standard-view
            tal:condition="not: hideDateTime"
            tal:define="tuple context/getDaysGroupedByMonth;
                    mDays python: tuple[0];
                    mKeys python: tuple[1];
                    monthTranslations python: tuple[2]"
          >
            <div
              tal:condition="python: len(mDays) > 0"
              class="pat-autotoc autotabs mb-4"
              data-pat-autotoc="section:fieldset;levels:legend;"
            >
              <fieldset tal:repeat="month mKeys">
                <legend>
                  <span tal:replace="python: monthTranslations[month]"></span>
                  <span
                    tal:replace="python: str( mDays[month][0].date.year )"
                  ></span>
                </legend>
                <div
                  tal:define="mIndex repeat/month/index;
                          days python: mDays[month];"
                >
                  <h3 tal:condition="not:days" i18n:translate="">
                    There are no upcoming days for this signup sheet.
                  </h3>

                  <h3 i18n:translate="month"></h3>

                  <div class="accordion" id="slots-accordion">
                    <tal:block tal:repeat="day days">
                      <div
                        class="accordion-item"
                        tal:define="index repeat/day/index;
                               curMonth python: day.date.strftime('%b');
                               bodyId python: str(mIndex) + '-' + str(index) + '-body';
                               isOpen python: len(days) <= 1"
                      >
                        <h4 class="accordion-header d-flex align-items-center">
                          <button
                            type="button"
                            data-bs-toggle="collapse"
                            tal:attributes="data-bs-target string:#${bodyId};
                                       aria-controls bodyId;
                                       aria-expanded python: 'true' if isOpen else 'false';
                                       class python: 'accordion-button flex-grow-1' if isOpen else 'accordion-button collapsed flex-grow-1'"
                          >
                            <tal:icon
                              replace="structure python: icons.tag('plone-calendar', tag_class='me-1')"
                            />
                            <span tal:replace="day/Title"></span>
                          </button>
                          <span class="d-flex align-items-center ms-2">
                            <a
                              tal:condition="view/showEditLinks"
                              i18n:attributes="title"
                              title="Edit day"
                              tal:attributes="href string:${day/absolute_url}/edit"
                            >
                              <tal:icon
                                replace="structure python: icons.tag('plone-edit', tag_alt='Edit day')"
                              />
                            </a>
                            <a
                              tal:condition="view/showEditLinks"
                              i18n:attributes="title"
                              title="View day"
                              tal:attributes="href string:${day/absolute_url}/view"
                            >
                              <tal:icon
                                replace="structure python: icons.tag('plone-view', tag_alt='View day')"
                              />
                            </a>
                          </span>
                        </h4>

                        <div
                          data-bs-parent="#slots-accordion"
                          tal:attributes="id bodyId;
                                     class python: 'accordion-collapse collapse show' if isOpen else 'accordion-collapse collapse'"
                        >
                          <div class="accordion-body">
                            <table class="listing table table-hover">
                              <thead>
                                <tr>
                                  <th tal:condition="view/showEditLinks"></th>
                                  <th
                                    tal:condition="showSlotNames"
                                    i18n:translate=""
                                  >
                                    Name
                                  </th>
                                  <th i18n:translate="">Time</th>
                                  <th
                                    tal:condition="not: hideAvailability"
                                    i18n:translate=""
                                  >
                                    Available
                                  </th>
                                  <th i18n:translate="">Select</th>
                                </tr>
                              </thead>

                              <tal:block
                                tal:define="timeSlots day/getTimeSlots"
                              >
                                <tr tal:condition="not:timeSlots">
                                  <td colspan="4" i18n:translate="">
                                    No slots have been made available for this
                                    day yet.
                                  </td>
                                </tr>
                                <div
                                  metal:use-macro="template/macros/macro-timeslots"
                                ></div>
                              </tal:block>
                            </table>
                          </div>
                        </div>
                      </div>
                    </tal:block>
                  </div>
                  <!-- accordion container -->
                </div>
                <!-- month tab container -->
              </fieldset>
            </div>
          </tal:standard-view>

          <tal:hide-date-time-view
            tal:condition="hideDateTime"
            tal:define="days context/getDays"
          >
            <div class="card">
              <table class="listing table table-hover">
                <thead>
                  <tr>
                    <th tal:condition="view/showEditLinks"></th>
                    <th tal:condition="showSlotNames" i18n:translate="">
                      Name
                    </th>
                    <th tal:condition="not: hideAvailability" i18n:translate="">
                      Available
                    </th>
                    <th i18n:translate="">Select</th>
                  </tr>
                </thead>
                <tbody>
                  <tal:days repeat="day days">
                    <tal:slots define="timeSlots day/getTimeSlots">
                      <div
                        metal:use-macro="template/macros/macro-timeslots"
                      ></div>
                    </tal:slots>
                  </tal:days>
                </tbody>
              </table>
            </div>
          </tal:hide-date-time-view>

          <tal:block tal:condition="isSignupAllowed">
            <div
              class="portalMessage statusmessage-info alert alert-info"
              role="alert"
              id="selectTimeslotInfo"
            >
              <tal:icon
                replace="structure python: icons.tag('plone-statusmessage-info', tag_alt='Info:', tag_class='statusmessage-icon mb-1 me-2')"
              />
              <strong i18n:translate="">Info:</strong>
              <span class="content" i18n:translate=""
                >Select a timeslot to proceed</span
              >
            </div>

            <div id="personalInfoFields" style="display: none">
              <div class="field mb-3">
                <label
                  for="inputPrename"
                  class="form-label"
                  i18n:translate="Prename"
                  >Your prename
                  <span
                    class="required"
                    title="required"
                    i18n:attributes="title"
                    title="Required"
                    >&nbsp;</span
                  > </label
                ><br />
                <input
                  id="inputPrename"
                  name="inputPrename"
                  type="text"
                  class="form-control"
                  i18n:attributes="placeholder Prename"
                />
              </div>
              <div class="field mb-3">
                <label
                  for="inputSurname"
                  class="form-label"
                  i18n:translate="Surname"
                  >Your surname
                  <span
                    class="required"
                    title="required"
                    i18n:attributes="title"
                    title="Required"
                    >&nbsp;</span
                  > </label
                ><br />
                <input
                  id="inputSurname"
                  name="inputSurname"
                  type="text"
                  class="form-control"
                  i18n:attributes="placeholder Surname"
                />
              </div>
              <div class="field mb-3">
                <label for="inputEmail" i18n:translate="Your email address"
                  >Your email address
                  <span
                    class="required"
                    title="required"
                    i18n:attributes="title"
                    title="Required"
                    >&nbsp;</span
                  > </label
                ><br />
                <input
                  id="inputEmail"
                  class="form-control"
                  name="inputEmail"
                  type="email"
                  placeholder="E-Mail"
                />
                <input type="hidden" name="isExternal" value="1" />
              </div>

              <tal:block tal:replace="structure view/renderExtraForm" />

              <div class="d-grid gap-2">
                <button
                  id="form-buttons-submit"
                  name="form.buttons.submit"
                  class="submit-widget button-field btn btn-primary"
                  type="submit"
                  i18n:translate=""
                >
                  Sign up
                </button>
              </div>
            </div>
          </tal:block>

          <div
            class="portalMessage statusmessage-error alert alert-danger"
            role="alert"
            tal:condition="not: isSignupAllowed"
          >
            <tal:icon
              replace="structure python: icons.tag('plone-statusmessage-error', tag_alt='Error:', tag_class='statusmessage-icon mb-1 me-2')"
            />
            <strong i18n:translate="">Error:</strong>
            <span class="content" i18n:translate=""
              >Signups are only allowed for authenticated users.</span
            >
            <br />
            <a
              tal:attributes="href string:${context/@@plone_portal_state/portal_url}/login_form?came_from=${context/absolute_url}"
              class="btn btn-primary mt-2"
              i18n:translate=""
              >Login</a
            >
          </div>
        </form>
      </tal:main-macro>
    </div>
  </body>
</html>
