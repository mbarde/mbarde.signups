<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="en"
  lang="en"
  metal:use-macro="here/main_template/macros/master"
  i18n:domain="mbarde.signups"
>
  <body>
    <div metal:fill-slot="main">
      <tal:main-macro
        metal:define-macro="main"
        tal:define="icons python: context.restrictedTraverse('@@iconresolver');
                     otpError python: getattr(view, 'otpError', None)"
      >
        <h2>
          <span tal:content="string:${context/Title}"></span> -
          <span i18n:translate="">Verify Your Email</span>
        </h2>

        <div
          class="portalMessage statusmessage-error alert alert-danger"
          role="alert"
          tal:condition="otpError"
        >
          <tal:icon
            replace="structure python: icons.tag('plone-statusmessage-error', tag_alt='Failure', tag_class='statusmessage-icon mb-1 me-2')"
          />
          <strong i18n:translate="">Failure</strong>
          <span class="content" tal:content="otpError" />
        </div>

        <tal:block tal:condition="view/token">
          <p i18n:translate="">
            We sent a verification code to the email address below. Please
            enter it to complete your signup.
          </p>
          <p tal:condition="view/email">
            <strong tal:content="view/email" />
          </p>

          <form
            method="post"
            id="formVerifyOtp"
            tal:attributes="action string:${context/absolute_url}/@@verify-signup-otp;"
          >
            <input type="hidden" name="token" tal:attributes="value view/token" />
            <div class="field mb-3">
              <label for="inputOtpCode" class="form-label" i18n:translate=""
                >Verification code</label
              ><br />
              <input
                id="inputOtpCode"
                name="code"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                class="form-control"
                i18n:attributes="placeholder"
                placeholder="Verification code"
              />
            </div>

            <div class="d-grid gap-2">
              <button
                id="form-buttons-verify"
                name="form.buttons.verify"
                class="submit-widget button-field btn btn-primary"
                type="submit"
                i18n:translate=""
              >
                Verify
              </button>
            </div>
          </form>
        </tal:block>

        <a
          tal:condition="not: view/token"
          tal:attributes="href string:${context/absolute_url};"
          class="btn btn-secondary"
        >
          <tal:icon
            replace="structure python: icons.tag('arrow-left-circle', tag_class='me-1')"
          />
          <span i18n:translate="">Return to the signup sheet</span>
        </a>
      </tal:main-macro>
    </div>
  </body>
</html>
