<html
  xmlns="http://www.w3.org/1999/xhtml"
  xml:lang="en"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:metal="http://xml.zope.org/namespaces/metal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  lang="en"
  metal:use-macro="context/main_template/macros/master"
  i18n:domain="mbarde.signups"
>
  <body>
    <metal:main fill-slot="main">
      <tal:main-macro metal:define-macro="main">
        <div tal:replace="structure provider:plone.abovecontenttitle" />

        <h1 class="documentFirstHeading" tal:content="context/title" />

        <div tal:replace="structure provider:plone.belowcontenttitle" />

        <p class="documentDescription" tal:content="context/description" />

        <div tal:replace="structure provider:plone.abovecontentbody" />

        <label i18n:translate="" tal:content="view/w/date/label" />
        <div tal:content="structure view/w/date/render" />
        <br />

        <tal:timeslots
          tal:define="timeslots context/getTimeSlots"
          tal:condition="timeslots"
        >
          <h3 i18n:translate="">Timeslots</h3>
          <ul>
            <li tal:repeat="timeslot context/getTimeSlots">
              <a
                tal:attributes="href timeslot/absolute_url"
                tal:content="timeslot/Title"
              />
            </li>
          </ul>
        </tal:timeslots>

        <br />

        <button
          class="btn btn-secondary"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#createSequentialTimeslotsForm"
          aria-expanded="false"
          aria-controls="createSequentialTimeslotsForm"
          i18n:translate=""
        >
          Create multiple timeslots
        </button>

        <div class="collapse mt-2" id="createSequentialTimeslotsForm">
          <form
            method="post"
            class="card card-body"
            tal:attributes="action string:${context/absolute_url}/create-sequential-timeslots"
          >
            <div class="mb-3">
              <label
                for="createSequentialTimeslotsStartTime"
                i18n:translate=""
              >Starting time</label>
              <input
                type="time"
                class="form-control"
                id="createSequentialTimeslotsStartTime"
                name="startTime"
                required="required"
              />
            </div>
            <div class="mb-3">
              <label
                for="createSequentialTimeslotsDuration"
                i18n:translate=""
              >Timeslot duration (minutes)</label>
              <input
                type="number"
                class="form-control"
                id="createSequentialTimeslotsDuration"
                name="timeslotDuration"
                min="1"
                value="15"
                required="required"
              />
            </div>
            <div class="mb-3">
              <label
                for="createSequentialTimeslotsCount"
                i18n:translate=""
              >Number of timeslots</label>
              <input
                type="number"
                class="form-control"
                id="createSequentialTimeslotsCount"
                name="numberOfTimeslots"
                min="1"
                value="4"
                required="required"
              />
            </div>
            <button
              type="submit"
              class="btn btn-primary"
              i18n:translate=""
            >Create timeslots</button>
          </form>
        </div>

        <div tal:replace="structure provider:plone.belowcontentbody" />
      </tal:main-macro>
    </metal:main>
  </body>
</html>
