<?xml version="1.0"?>
<dc-workflow workflow_id="ut_person_workflow"
  title="UTPerson Workflow"
  description=""
  state_variable="review_state"
  initial_state="unconfirmed">
  <permission>Access contents information</permission>
  <permission>Modify portal content</permission>
  <permission>View</permission>

  <state state_id="signedup" title="Signed Up">
    <description>This person is signed up for the time slot</description>
    <exit-transition transition_id="signoff" />
    <permission-map name="Access contents information"
      acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Modify portal content"
      acquired="False">
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="View" acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>

  <state state_id="unconfirmed" title="Waiting for confirmation">
    <description>This person has not been confirmed yet</description>
    <exit-transition transition_id="signup" />
    <exit-transition transition_id="signoff" />
    <exit-transition transition_id="putOnWaitingList" />
    <permission-map name="Access contents information"
      acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Modify portal content"
      acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="View" acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>

  <state state_id="signedoff" title="Signed off">
    <description>This person has been signed off</description>
    <exit-transition transition_id="signup" />
    <exit-transition transition_id="putOnWaitingList" />
    <permission-map name="Access contents information"
      acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Modify portal content"
      acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="View" acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>

  <state state_id="waiting" title="Waiting List">
    <description>This person has been added to the waiting list</description>
    <exit-transition transition_id="signup" />
    <exit-transition transition_id="signoff" />
    <permission-map name="Access contents information"
      acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="Modify portal content"
      acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map name="View" acquired="False">
      <permission-role>Owner</permission-role>
      <permission-role>Editor</permission-role>
      <permission-role>Reviewer</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>

  <!--
    The guards on the signup/signoff/putOnWaitingList transitions below are
    intentionally left empty (no guard-permission/guard-role/guard-expression)
    - please do not "fix" this by adding e.g. a Modify-portal-content guard.

    UTPerson objects created for anonymous/external signups are deliberately
    given no local role at all (view_submitselection.py's createPersonObject
    bypasses api.content.create() specifically to avoid granting the
    anonymous submitter any permission on the object), and the states'
    permission-maps restrict "Modify portal content" to Owner/Editor/
    Reviewer/Manager with acquired="False". A permission-based guard here
    would therefore make api.content.transition() fail for that very same
    anonymous submitter one line later, breaking external signup entirely -
    and likewise for subscribers.attemptToFillEmptySpot(), which promotes a
    *different* person from the waiting list using whatever security context
    happens to be active after a signoff.

    Instead, authorization is enforced entirely in application code: every
    call site that triggers these transitions (view_cancelreservation.py,
    view_submitselection.py, subscribers.py) resolves its target person
    either from the caller's own session identity or from a business rule
    (oldest waiting person) - never from a client-supplied person id - so
    there is currently no path for a user to change another person's state.
    That protection lives entirely in that application code though, not in
    this workflow, so any *new* call site added in the future gets no
    enforcement from the workflow layer and must uphold this discipline
    itself.
  -->

  <transition transition_id="signup"
    title="Signup"
    new_state="signedup" trigger="USER"
    before_script="" after_script="">
    <description>This signs the person up for a day</description>
    <action url="%(content_url)s/content_status_modify?workflow_action=signup"
      category="workflow">Signup</action>
    <guard></guard>
  </transition>

  <transition transition_id="signoff"
    title="Cancel signup"
    new_state="signedoff" trigger="USER"
    before_script="" after_script="">
    <description>This cancels a signup</description>
    <action url="%(content_url)s/content_status_modify?workflow_action=signoff"
      category="workflow">Cancel signup</action>
    <guard></guard>
  </transition>

  <transition transition_id="putOnWaitingList"
    title="Put on waiting list"
    new_state="waiting" trigger="USER"
    before_script="" after_script="">
    <description>This puts the person on the waiting list</description>
    <action url="%(content_url)s/content_status_modify?workflow_action=putOnWaitingList"
      category="workflow">Put on waiting list</action>
    <guard></guard>
  </transition>

  <variable variable_id="action" for_catalog="False"
    for_status="True" update_always="True">
    <description>Previous transition</description>
    <default>
      <expression>transition/getId|nothing</expression>
    </default>
    <guard></guard>
  </variable>

  <variable variable_id="actor" for_catalog="False"
    for_status="True" update_always="True">
    <description>The ID of the user who performed the last transition</description>
    <default>
      <expression>user/getId</expression>
    </default>
    <guard></guard>
  </variable>

  <variable variable_id="comments" for_catalog="False"
    for_status="True" update_always="True">
    <description>Comment about the last transition</description>
    <default>
      <expression>python:state_change.kwargs.get('comment', '')</expression>
    </default>
    <guard></guard>
  </variable>

  <variable variable_id="review_history" for_catalog="False"
    for_status="False" update_always="False">
    <description>Provides access to workflow history</description>
    <default>
      <expression>state_change/getHistory</expression>
    </default>
    <guard>
      <guard-permission>Request review</guard-permission>
      <guard-permission>Review portal content</guard-permission>
    </guard>
  </variable>

  <variable variable_id="time" for_catalog="False"
    for_status="True" update_always="True">
    <description>When the previous transition was performed</description>
    <default>

      <expression>state_change/getDateTime</expression>
    </default>
    <guard></guard>
  </variable>
</dc-workflow>